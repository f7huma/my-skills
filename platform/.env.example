# =====================================================================
# منصة مكتب فيصل حميضان الحميضان للمحاماة والاستشارات القانونية
# انسخ هذا الملف إلى .env لكل بيئة على حدة (تطوير / اختبار / معاينة / إنتاج).
# لا تضع أي سر حقيقي في هذا الملف ولا في المستودع.
# =====================================================================

APP_NAME="مكتب فيصل حميضان الحميضان للمحاماة"
# local | testing | preview | production
APP_ENV=local
# يُولَّد لكل بيئة: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# عنوان الموقع متغير إعداد: غيّره عند الانتقال من الدومين المؤقت إلى الدائم ثم أعد تشغيل الحاويات (لا حاجة لإعادة البناء)
APP_URL=http://localhost:8000
# المنطقة الزمنية للتخزين تبقى UTC، والعرض والحساب الإجرائي بتوقيت الرياض
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# بيئة المعاينة: true يضيف X-Robots-Tag: noindex ويمنع أي فهرسة
APP_NOINDEX=false
# تقييد وصول مستقل قبل شاشة الدخول (Basic Auth على مستوى التطبيق، إضافة لتقييد الوكيل العكسي)
PREVIEW_GATE_ENABLED=false
PREVIEW_GATE_USER=
# قيمة bcrypt: php -r "echo password_hash('...', PASSWORD_BCRYPT), PHP_EOL;"
PREVIEW_GATE_PASSWORD_HASH=
# إذا كانت true يرفض التطبيق أي بيانات غير اصطناعية (يمنع تشغيل المعاينة على قاعدة الإنتاج)
SYNTHETIC_DATA_ONLY=false

# المصادقة متعددة العوامل إلزامية للمحامي عند true (إلزامية دائمًا في production)
MFA_REQUIRED_FOR_LAWYER=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=humaidan_dev
DB_USERNAME=humaidan
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
# اتركه فارغًا ليتبع الدومين الحالي، أو ضع الدومين الدائم عند الانتقال
SESSION_DOMAIN=
# true في المعاينة والإنتاج (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------
# المرفقات: مساحة خاصة دائمة خارج جذر الويب + تشفير على مستوى الملف
# ---------------------------------------------------------------------
# مسار التخزين الخاص (في Docker: /var/lib/humaidan/files على وحدة تخزين دائمة)
ATTACHMENTS_ROOT=
# مفتاح تشفير الملفات منفصل عن APP_KEY. يُولَّد: php artisan files:generate-key
# يُحفظ خارج الخادم أيضًا (خزنة كلمات مرور المكتب). فقدانه = فقدان الملفات.
FILES_ENCRYPTION_KEY=
# مفاتيح سابقة (مفصولة بفواصل) لفك تشفير الملفات القديمة أثناء التدوير
FILES_PREVIOUS_KEYS=
ATTACHMENTS_MAX_KB=25600

# فحص البرمجيات الخبيثة محليًا: clamav | fake (للتطوير والاختبار فقط) | disabled (يبقي الملفات محجوزة)
SCANNER_DRIVER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60

# ---------------------------------------------------------------------
# النسخ الاحتياطي
# ---------------------------------------------------------------------
BACKUP_PATH=
# مفتاح منفصل لتشفير النسخ: php artisan files:generate-key --backup
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_MAX_AGE_HOURS=26
# مسار يُركَّب عليه وجهة منفصلة عن قرص التطبيق (SFTP/NFS تحت حساب المكتب). فارغ = غير مضبوط
BACKUP_OFFSITE_PATH=

# ---------------------------------------------------------------------
# التنبيهات التشغيلية (لا تتضمن أسماء عملاء أو ملفات)
# ---------------------------------------------------------------------
OPS_ALERT_MAIL=
OPS_ALERT_WEBHOOK=
DISK_MIN_FREE_PERCENT=15
TLS_CHECK_HOST=
TLS_MIN_DAYS=14

# نافذة تنبيه الوكالات القريبة من الانتهاء (أيام) — قابلة للتعديل من الإعدادات
POA_EXPIRY_WARNING_DAYS=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
