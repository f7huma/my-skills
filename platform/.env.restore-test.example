# بيئة اختبار الاستعادة المعزولة. تستخدم مفاتيح الإنتاج للفك فقط (FILES/BACKUP) ولا تتصل بقاعدة الإنتاج.
APP_NAME="اختبار استعادة"
APP_ENV=restore-test
APP_KEY=           # مفتاح APP_KEY للإنتاج (لفك الحقول المشفرة مثل أسرار المصادقة)
APP_URL=http://127.0.0.1:18080
APP_DEBUG=false
APP_NOINDEX=true
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=humaidan
DB_USERNAME=humaidan
DB_PASSWORD=restore-test-only
FILES_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
SCANNER_DRIVER=disabled
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
